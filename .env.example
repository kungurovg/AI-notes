# --- AI / model ---
# Groq API key (https://console.groq.com/keys)
GROQ_API_KEY=

# --- Better Auth ---
# Секрет для подписи сессий. Сгенерируйте: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Публичный URL приложения. Локально: http://localhost:3000
BETTER_AUTH_URL=
# Публичный URL для клиента (тот же, что и BETTER_AUTH_URL)
NEXT_PUBLIC_BETTER_AUTH_URL=

# --- База данных (Turso / libsql) ---
# Удалённая БД для прода. Локально можно не задавать — будет использован файл notes.db
# 1) Создайте БД: npx turso db create ai-notes
# 2) Получите URL и токен: npx turso db show ai-notes --url  /  npx turso db tokens create ai-notes
TURSO_DATABASE_URL=libsql://your-database.turso.io
TURSO_AUTH_TOKEN=
